# Copy to .env (not committed) and fill in. Read by docker-compose.yaml.

# Y accepts the licence terms of the Service Bus emulator and SQL Server Linux:
# https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
# https://go.microsoft.com/fwlink/?LinkId=746388
ACCEPT_EULA="N"

# Password for the SQL Server container the emulator uses internally.
# At least 8 characters with three of: upper case, lower case, digits, symbols.
MSSQL_SA_PASSWORD=""

# Port for the emulator's management and health-check API.
EMULATOR_HTTP_PORT=5300
